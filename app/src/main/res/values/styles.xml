<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 화면 제목 : "홈", "무엇을 할까요?" -->
    <style name="Text.ScreenTitle" parent="">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 섹션 제목 : "최근 훈련 기록", "이번 주 훈련 기록" -->
    <style name="Text.SectionTitle" parent="">
        <item name="android:fontFamily">@font/pretendard_extrabold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 카드 대제목 : "재난 시뮬레이션" -->
    <style name="Text.CardTitle" parent="">
        <item name="android:fontFamily">@font/pretendard_extrabold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 훈련탭 카드 대제목 (홈보다 한 단계 큼) -->
    <style name="Text.CardTitle.Large" parent="Text.CardTitle">
        <item name="android:textSize">22sp</item>
    </style>

    <!-- 카드 머리말 : "카메라로 배우는 대피 방법" -->
    <style name="Text.Eyebrow" parent="">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/orange_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 카드 본문 설명 -->
    <style name="Text.Body" parent="">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">5sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 목록 항목 제목 -->
    <style name="Text.ItemTitle" parent="">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 목록 항목 메타 : "지진 대피 · 7월 17일 10:05" -->
    <style name="Text.ItemMeta" parent="">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 점수 : "92점" -->
    <style name="Text.Score" parent="">
        <item name="android:fontFamily">@font/pretendard_extrabold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/orange_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 통계 수치 : "110" -->
    <style name="Text.StatValue" parent="">
        <item name="android:fontFamily">@font/pretendard_extrabold</item>
        <item name="android:textSize">27sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 통계 단위 : "분" -->
    <style name="Text.StatUnit" parent="">
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_unit</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 요일 라벨 -->
    <style name="Text.ChartLabel" parent="">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 성취 칩 : "✓ 대피 자세" -->
    <style name="Text.Chip" parent="">
        <item name="android:fontFamily">@font/pretendard_extrabold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/green_success</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 링크 : "전체 보기 >" -->
    <style name="Text.Link" parent="">
        <item name="android:fontFamily">@font/pretendard_extrabold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/orange_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 하단 탭 라벨 -->
    <style name="Text.NavLabel" parent="">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/nav_item</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 인증 화면 제목 : "회원가입", "비밀번호 찾기" -->
    <style name="Text.AuthTitle" parent="">
        <item name="android:fontFamily">@font/pretendard_extrabold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 인증 화면 안내문 -->
    <style name="Text.AuthDesc" parent="">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 필드 옆 작은 버튼 : "이메일 발송" -->
    <style name="Button.Small" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:layout_height">@dimen/field_height</item>
        <item name="android:minWidth">86dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="backgroundTint">@color/orange_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 필드 옆 작은 버튼(테두리형) : "확인" -->
    <style name="Button.Small.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:layout_height">@dimen/field_height</item>
        <item name="android:minWidth">86dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/orange_primary</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="strokeColor">@color/orange_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 하단 고정 CTA : "가입하기", "확인", "다음" -->
    <style name="Button.Cta" parent="Button.Primary">
        <item name="android:textSize">20sp</item>
    </style>

    <!-- 약관 항목 라벨 -->
    <style name="Text.Agreement" parent="">
        <item name="android:fontFamily">@font/pretendard_extralight</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Dialog.Deundeun" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_primary</item>
        <item name="colorSecondary">@color/orange_primary</item>
    </style>

    <!-- SOS 질문 선택지 -->
    <style name="Option.Sos" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/bg_sos_option</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 보호자 관계 선택 칩 -->
    <style name="Chip.Relation" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">62dp</item>
        <item name="android:background">@drawable/bg_chip_relation</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/chip_relation_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 카드 -->
    <style name="Card.Deundeun" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="android:outlineAmbientShadowColor">@color/card_shadow</item>
        <item name="android:outlineSpotShadowColor">@color/card_shadow</item>
    </style>

    <!-- 주 버튼 : 주황 채움 -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/orange_primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 보조 버튼 : 주황 테두리 -->
    <style name="Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/orange_primary</item>
        <item name="strokeColor">@color/orange_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>
