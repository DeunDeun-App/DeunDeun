<?xml version="1.0" encoding="utf-8"?>
<!-- 약관 항목의 동의 여부. checked 는 주황, 아니면 회색. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/orange_primary" android:state_checked="true" />
    <item android:color="@color/orange_primary" android:state_selected="true" />
    <item android:color="@color/agree_check_off" />
</selector>
