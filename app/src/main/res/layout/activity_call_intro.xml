<?xml version="1.0" encoding="utf-8"?>
<!-- 119 신고 연습 진입 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/call_intro_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.call.CallIntroActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/call_intro_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_h_margin"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/screen_h_margin"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/cta_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.example.deundeun.ui.common.FeatureHeaderView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:featureEyebrow="@string/call_eyebrow"
                app:featureTitle="@string/call_intro_title" />

            <ImageView
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_circle_orange"
                android:importantForAccessibility="no"
                android:padding="30dp"
                android:src="@drawable/ic_phone"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_l"
                android:fontFamily="@font/pretendard_extrabold"
                android:includeFontPadding="false"
                android:text="@string/call_intro_question"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:text="@string/call_intro_desc" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Deundeun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/Text.ItemMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_m"
                        android:text="@string/call_steps_title" />

                    <TextView
                        style="@style/Text.ItemTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/call_step_1"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_m"
                        android:layout_marginBottom="@dimen/space_m"
                        android:background="@color/divider" />

                    <TextView
                        style="@style/Text.ItemTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/call_step_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_m"
                        android:layout_marginBottom="@dimen/space_m"
                        android:background="@color/divider" />

                    <TextView
                        style="@style/Text.ItemTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/call_step_3"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/cta_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            style="@style/Button.Cta"
            android:layout_width="match_parent"
            android:text="@string/call_start" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
