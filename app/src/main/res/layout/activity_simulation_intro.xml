<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 67:1077 — 지진대피 시뮬레이션 진입 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sim_intro_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.simulation.SimulationIntroActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sim_intro_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_h_margin"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/screen_h_margin"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/cta_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.example.deundeun.ui.common.FeatureHeaderView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:featureEyebrow="@string/sim_eyebrow"
                app:featureTitle="@string/sim_intro_title" />

            <include
                android:id="@+id/scenario_earthquake"
                layout="@layout/view_scenario_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l" />

            <include
                android:id="@+id/scenario_fire"
                layout="@layout/view_scenario_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m" />

            <!-- 이렇게 해요 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_info_yellow"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Text.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_m"
                    android:text="@string/sim_howto_title" />

                <include
                    android:id="@+id/howto_1"
                    layout="@layout/view_numbered_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/howto_2"
                    layout="@layout/view_numbered_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m" />

                <include
                    android:id="@+id/howto_3"
                    layout="@layout/view_numbered_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/cta_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            style="@style/Button.Cta"
            android:layout_width="match_parent"
            android:text="@string/sim_start" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
