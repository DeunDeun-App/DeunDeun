<?xml version="1.0" encoding="utf-8"?>
<!-- 재난문자 쉬운 말로 보기 -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/translate_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipToPadding="false"
    android:paddingStart="@dimen/screen_h_margin"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/screen_h_margin"
    android:paddingBottom="@dimen/space_xl"
    android:scrollbars="none"
    tools:context=".ui.translate.DisasterTranslateActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.example.deundeun.ui.common.FeatureHeaderView
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:featureEyebrow="@string/translate_eyebrow"
            app:featureTitle="@string/translate_title" />

        <!-- 원문 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Deundeun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_s">

                    <TextView
                        android:id="@+id/original_label"
                        style="@style/Text.ItemMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="@string/translate_recent" />

                    <LinearLayout
                        android:id="@+id/message_pager"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/btn_prev_message"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cd_prev_message"
                            android:padding="8dp"
                            android:src="@drawable/ic_arrow_back" />

                        <TextView
                            android:id="@+id/message_position"
                            style="@style/Text.ItemMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="1 / 5" />

                        <ImageView
                            android:id="@+id/btn_next_message"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cd_next_message"
                            android:padding="8dp"
                            android:rotation="180"
                            android:src="@drawable/ic_arrow_back" />

                    </LinearLayout>

                </RelativeLayout>

                <TextView
                    android:id="@+id/original_message"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    tools:text="[행정안전부] 경기 수원시 지역에 호우주의보 발효. 침수 위험지역 주민 대피 권고." />

                <TextView
                    android:id="@+id/original_meta"
                    style="@style/Text.ItemMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="경기도 수원시 · 7월 17일 10:05"
                    tools:visibility="visible" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- AI 번역 결과 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/result_card"
            style="@style/Card.Deundeun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/result_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/result_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_pill_orange"
                        android:fontFamily="@font/pretendard_extrabold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/translate_badge"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/result_badge_desc"
                        style="@style/Text.ItemMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/translate_badge_desc" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/result_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_xl"
                    android:paddingBottom="@dimen/space_xl"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/result_progress"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:indeterminateTint="@color/orange_primary" />

                    <TextView
                        android:id="@+id/result_status_text"
                        style="@style/Text.ItemMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:gravity="center"
                        android:lineSpacingExtra="4sp"
                        tools:text="쉬운 말로 바꾸는 중입니다." />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/result_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 지금 이렇게 하세요 카드 -->
                <LinearLayout
                    android:id="@+id/action_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_action_red"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_extrabold"
                        android:includeFontPadding="false"
                        android:text="@string/translate_action_title"
                        android:textColor="@color/action_red_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/action_desc"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/action_red_text"
                        android:textSize="13sp"
                        tools:text="1층이나 지하 위층으로 올라가요\n밖에 있다면 건물 안으로 들어가요" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
