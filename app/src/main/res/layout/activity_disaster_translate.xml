<?xml version="1.0" encoding="utf-8"?>
<!-- 재난문자 쉬운 말로 보기 -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/translate_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipToPadding="false"
    android:paddingStart="@dimen/screen_h_margin"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/screen_h_margin"
    android:paddingBottom="@dimen/space_xl"
    android:scrollbars="none"
    tools:context=".ui.translate.DisasterTranslateActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.example.deundeun.ui.common.FeatureHeaderView
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:featureEyebrow="@string/translate_eyebrow"
            app:featureTitle="@string/translate_title" />

        <!-- 원문 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Deundeun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Text.ItemMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/translate_recent" />

                <TextView
                    android:id="@+id/original_message"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/translate_sample"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- AI 번역 결과 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Deundeun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_pill_orange"
                        android:fontFamily="@font/pretendard_extrabold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/translate_badge"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/Text.ItemMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/translate_badge_desc" />

                </LinearLayout>

                <include
                    android:id="@+id/result_1"
                    layout="@layout/view_translate_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/result_2"
                    layout="@layout/view_translate_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m" />

                <include
                    android:id="@+id/result_3"
                    layout="@layout/view_translate_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m" />

                <!-- 지금 이렇게 하세요 카드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_action_red"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_extrabold"
                        android:includeFontPadding="false"
                        android:text="@string/translate_action_title"
                        android:textColor="@color/action_red_text"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/translate_action_desc"
                        android:textColor="@color/action_red_text"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
