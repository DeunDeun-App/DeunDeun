<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 63:197 — 훈련탭 -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/training_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="100dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_margin"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/screen_h_margin">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xl"
            android:text="@string/training_title"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:fontFamily="@font/pretendard_extrabold" />

        <include
            android:id="@+id/card_simulation"
            layout="@layout/view_training_menu_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_l" />

        <include
            android:id="@+id/card_emergency_call"
            layout="@layout/view_training_menu_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_l" />

        <include
            android:id="@+id/card_translate"
            layout="@layout/view_training_menu_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="NestedWeights" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
