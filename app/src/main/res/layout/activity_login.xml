<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 88:54 — 로그인 -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.auth.LoginActivity">

    <!-- fillViewport + match_parent 라야 아래 Space 의 weight 가 남는 높이를 먹는다 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingBottom="@dimen/space_xl">

        <!-- 로고. 시안(88:54)의 든든 워드마크 자리 -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="120dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_logo_wordmark" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="120dp" />

        <com.example.deundeun.ui.common.LabeledInputView
            android:id="@+id/input_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            app:labelText="@string/label_email" />

        <com.example.deundeun.ui.common.LabeledInputView
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/hint_password_login"
            android:inputType="textPassword"
            app:labelText="@string/label_password"
            app:password="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_login"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/action_login" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_signup"
            style="@style/Button.Secondary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/action_signup" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_find_email"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:text="@string/action_find_email"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:background="@color/field_stroke" />

            <TextView
                android:id="@+id/btn_find_password"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:text="@string/action_find_password"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
