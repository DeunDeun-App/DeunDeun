<?xml version="1.0" encoding="utf-8"?>
<!-- 내 정보 수정 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_edit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.profile.ProfileEditActivity">

    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/edit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/pretendard_extrabold"
            android:includeFontPadding="false"
            android:text="@string/profile_edit_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/edit_title"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="bottom|center_horizontal"
            android:includeFontPadding="false"
            android:minHeight="48dp"
            android:text="@string/action_save"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:translationY="2dp" />

    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profile_edit_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_h_margin"
        android:paddingEnd="@dimen/screen_h_margin"
        android:paddingBottom="@dimen/space_xl"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 기본 정보 -->
            <TextView
                style="@style/Text.ItemMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/profile_section_basic"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Deundeun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <include
                        android:id="@+id/field_name"
                        layout="@layout/view_edit_field" />

                    <include
                        android:id="@+id/field_phone"
                        layout="@layout/view_edit_field" />

                    <include
                        android:id="@+id/field_birth"
                        layout="@layout/view_edit_field" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 장애 정보 -->
            <TextView
                style="@style/Text.ItemMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/profile_section_disability"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Deundeun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <include
                        android:id="@+id/field_disability_type"
                        layout="@layout/view_edit_field" />

                    <include
                        android:id="@+id/field_disability_level"
                        layout="@layout/view_edit_field" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 보호자 정보 -->
            <TextView
                style="@style/Text.ItemMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/profile_section_guardian"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Deundeun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="18dp">

                    <TextView
                        style="@style/Text.ItemMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/field_relation"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/relation_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:layout_marginBottom="@dimen/space_s"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/relation_mother"
                            style="@style/Chip.Relation"
                            android:text="@string/relation_mother" />

                        <TextView
                            android:id="@+id/relation_father"
                            style="@style/Chip.Relation"
                            android:layout_marginStart="@dimen/space_s"
                            android:text="@string/relation_father" />

                        <TextView
                            android:id="@+id/relation_other"
                            style="@style/Chip.Relation"
                            android:layout_marginStart="@dimen/space_s"
                            android:text="@string/relation_other" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <include
                        android:id="@+id/field_guardian_name"
                        layout="@layout/view_edit_field" />

                    <include
                        android:id="@+id/field_guardian_phone"
                        layout="@layout/view_edit_field" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SOS 연락처 안내 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_warning_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info" />

                <TextView
                    style="@style/Text.ItemMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/profile_edit_warning"
                    android:textColor="@color/orange_primary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
