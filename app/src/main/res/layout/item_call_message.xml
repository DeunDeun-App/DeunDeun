<?xml version="1.0" encoding="utf-8"?>
<!--
     통화 말풍선 한 줄.
    상담원과 나 두 방향을 한 레이아웃에서 처리함
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/avatar_operator"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_alignParentStart="true"
        android:background="@drawable/bg_circle_red"
        android:contentDescription="@string/cd_operator"
        android:padding="7dp"
        android:src="@drawable/ic_phone"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/avatar_me"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_alignParentEnd="true"
        android:background="@drawable/bg_circle_orange"
        android:contentDescription="@string/cd_me"
        android:padding="7dp"
        android:src="@drawable/ic_nav_profile"
        android:visibility="gone"
        app:tint="@color/white"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/message_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_toEndOf="@id/avatar_operator"
        android:background="@drawable/bg_bubble_other"
        android:fontFamily="@font/pretendard_semibold"
        android:includeFontPadding="false"
        android:maxWidth="250dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        tools:text="네, 119입니다. 무엇을 도와드릴까요?" />

</RelativeLayout>
