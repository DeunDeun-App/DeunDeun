<?xml version="1.0" encoding="utf-8"?>
<!-- 라벨이 값 위에 오는 수정용 필드. 테두리 없이 구분선만 씀. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_m">

        <ImageView
            android:id="@+id/field_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/cd_dropdown"
            android:rotation="-90"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/field_label"
            style="@style/Text.ItemMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="이름" />

        <EditText
            android:id="@+id/field_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/field_label"
            android:layout_marginTop="6dp"
            android:layout_toStartOf="@id/field_chevron"
            android:background="@null"
            android:fontFamily="@font/pretendard_semibold"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:ignore="Autofill,LabelFor"
            tools:text="김든든" />

    </RelativeLayout>

    <View
        android:id="@+id/field_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

</LinearLayout>
