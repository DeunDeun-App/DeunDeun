<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/find_id_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.auth.FindIdActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/find_id_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="25dp"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="25dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/cta_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.example.deundeun.ui.common.AuthHeaderView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:authDesc="@string/find_id_desc"
                app:authTitle="@string/find_id_title" />

            <com.example.deundeun.ui.common.LabeledInputView
                android:id="@+id/input_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:hint="@string/hint_name"
                android:inputType="textPersonName"
                app:labelText="@string/label_name"
                app:required="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.example.deundeun.ui.common.LabeledInputView
                    android:id="@+id/input_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    app:labelText="@string/label_email"
                    app:required="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_email"
                    style="@style/Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_marginTop="26dp"
                    android:text="@string/action_send_email" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/auth_code_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.example.deundeun.ui.common.LabeledInputView
                    android:id="@+id/input_auth_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    app:labelText="@string/label_auth_code"
                    app:required="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_verify_code"
                    style="@style/Button.Small.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_marginTop="26dp"
                    android:text="@string/action_verify" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/cta_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingStart="15dp"
        android:paddingTop="10dp"
        android:paddingEnd="15dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit"
            style="@style/Button.Cta"
            android:layout_width="match_parent"
            android:text="@string/action_confirm" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
