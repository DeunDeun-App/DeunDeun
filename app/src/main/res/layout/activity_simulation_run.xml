<?xml version="1.0" encoding="utf-8"?>
<!--
    시뮬레이션 진행 화면.
    CameraX 프리뷰 위에 MediaPipe 로 인식한 관절을 겹쳐 그린다.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sim_run_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".ui.simulation.SimulationRunActivity">

    <!-- 상단 바 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="@dimen/min_touch_target"
        android:layout_height="@dimen/min_touch_target"
        android:layout_marginStart="@dimen/space_s"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_back"
        android:scaleType="center"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="@id/badge_scenario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/badge_scenario"
        app:tint="@color/orange_primary" />

    <TextView
        android:id="@+id/badge_scenario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/bg_camera_badge"
        android:drawablePadding="8dp"
        android:fontFamily="@font/pretendard_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:drawableStartCompat="@drawable/ic_dot_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="지진 대피 훈련" />

    <!-- 카메라 프리뷰 자리 -->
    <FrameLayout
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_l"
        android:background="@color/text_primary"
        android:contentDescription="@string/cd_camera_preview"
        app:layout_constraintBottom_toTopOf="@id/guide_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/badge_scenario">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- 지진 시나리오에서만 보인다: 실제 방 대신 지진 난 방 사진 위에 오려낸 사람을 그리고,
             사진 속 책상은 사람 앞에 다시 그려 책상 밑에 들어간 것처럼 보이게 한다 -->
        <com.example.deundeun.ui.simulation.VirtualBackgroundView
            android:id="@+id/virtual_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 지진 시나리오에서만 보인다: 금 간 자국·먼지·흔들림 -->
        <com.example.deundeun.ui.simulation.EarthquakeEffectView
            android:id="@+id/quake_effect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.example.deundeun.ui.simulation.pose.PoseOverlayView
            android:id="@+id/pose_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 시안의 네 모서리 프레임 -->
        <com.example.deundeun.ui.simulation.CornerFrameView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp" />

        <!-- 자세 장면에서 걸린 시간. 30초 안에 하면 점수를 더 받고 60초가 넘으면 깎인다 -->
        <TextView
            android:id="@+id/pose_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="20dp"
            android:background="@drawable/bg_pose_timer"
            android:fontFamily="@font/pretendard_bold"
            android:includeFontPadding="false"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:visibility="gone"
            tools:text="⏱ 12초"
            tools:visibility="visible" />

    </FrameLayout>

    <!-- 고르기 장면에서 카메라 대신 보여주는 장면 카드. 카메라는 자세를 해 볼 때만 켠다.
         그림은 3:4 로 고정해 기기가 달라도 잘리지 않고, 상황 문장은 그림 아래쪽에 겹쳐 쓴다.
         고른 뒤의 피드백은 그림 밑 story_feedback 에 쓴다 -->
    <FrameLayout
        android:id="@+id/scene_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="@dimen/space_m"
        android:background="@drawable/bg_story_scene"
        app:layout_constraintDimensionRatio="720:964"
        app:layout_constraintVertical_bias="0"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/story_feedback"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/badge_scenario">

        <!-- 둥근 모서리는 scene_panel 의 clipToOutline 으로 자른다 -->
        <ImageView
            android:id="@+id/story_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            tools:src="@drawable/story_quake_1" />

        <TextView
            android:id="@+id/scene_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_story_caption"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="4sp"
            android:paddingStart="16dp"
            android:paddingTop="48dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:textColor="@color/white"
            android:textSize="20sp"
            tools:text="부엌에서 불이 났어요! 연기가 나요" />

    </FrameLayout>

    <!-- 고르기 장면의 피드백. 글이 생겨도 그림 크기가 바뀌지 않게 세 줄 높이를 늘 잡아 둔다 -->
    <TextView
        android:id="@+id/story_feedback"
        android:layout_width="0dp"
        android:layout_height="@dimen/story_feedback_height"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="@dimen/space_s"
        android:fontFamily="@font/pretendard_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="6sp"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:visibility="gone"
        app:autoSizeMaxTextSize="22sp"
        app:autoSizeMinTextSize="16sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/cta_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="숨으면 연기를 마시고\n구조대가 찾기 어려워요\n다시 골라 볼까요?"
        tools:visibility="visible" />

    <!-- AI 가이드 -->
    <LinearLayout
        android:id="@+id/guide_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="@dimen/space_m"
        android:background="@drawable/bg_camera_guide"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/cta_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/guide_label"
            style="@style/Text.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sim_ai_guide" />

        <TextView
            android:id="@+id/guide_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:lineSpacingExtra="4sp"
            tools:text="탁자가 있어요! 탁자 밑으로 들어가 몸을 낮추세요" />

    </LinearLayout>

    <!-- 하단 버튼 자리. 이야기 고르기 장면에서는 두 선택지를, 그 밖에는 상태 버튼을 보여준다 -->
    <LinearLayout
        android:id="@+id/cta_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="15dp"
        android:gravity="bottom"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_choice_1"
            style="@style/Button.StoryChoice"
            android:visibility="gone"
            tools:text="책상 밑으로 들어가요"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_choice_2"
            style="@style/Button.StoryChoice"
            android:visibility="gone"
            tools:text="밖으로 뛰어나가요"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_status"
            style="@style/Button.Cta"
            android:layout_width="match_parent"
            android:text="@string/sim_detecting" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
