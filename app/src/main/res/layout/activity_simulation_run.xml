<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma 74:42 — 시뮬레이션 진행 화면.
    카메라 프리뷰 자리는 지금 비어 있다. CameraX + 포즈 인식 연동은 별도 작업.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sim_run_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".ui.simulation.SimulationRunActivity">

    <!-- 상단 바 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="@dimen/min_touch_target"
        android:layout_height="@dimen/min_touch_target"
        android:layout_marginStart="@dimen/space_s"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_back"
        android:scaleType="center"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="@id/badge_scenario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/badge_scenario"
        app:tint="@color/orange_primary" />

    <TextView
        android:id="@+id/badge_scenario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/bg_camera_badge"
        android:drawablePadding="8dp"
        android:fontFamily="@font/pretendard_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:drawableStartCompat="@drawable/ic_dot_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="지진 대피 훈련" />

    <!-- 카메라 프리뷰 자리 -->
    <FrameLayout
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_l"
        android:background="@color/text_primary"
        android:contentDescription="@string/cd_camera_preview"
        app:layout_constraintBottom_toTopOf="@id/guide_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/badge_scenario">

        <!-- 시안의 네 모서리 프레임 -->
        <com.example.deundeun.ui.simulation.CornerFrameView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp" />

    </FrameLayout>

    <!-- AI 가이드 -->
    <LinearLayout
        android:id="@+id/guide_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="@dimen/space_m"
        android:background="@drawable/bg_camera_guide"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/btn_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/guide_label"
            style="@style/Text.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sim_ai_guide" />

        <TextView
            android:id="@+id/guide_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            tools:text="탁자가 있어요! 탁자 밑으로 들어가 몸을 낮추세요" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_status"
        style="@style/Button.Cta"
        android:layout_width="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="15dp"
        android:text="@string/sim_detecting"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
