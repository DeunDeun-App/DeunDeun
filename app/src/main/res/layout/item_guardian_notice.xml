<?xml version="1.0" encoding="utf-8"?>
<!-- 보호자에게 보낸 알림 한 건 -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card.Deundeun"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/profile_notice_item_gap">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp">

        <LinearLayout
            android:id="@+id/notice_time_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notice_date"
                style="@style/Text.ItemMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                tools:text="7월 17일" />

            <TextView
                android:id="@+id/notice_time"
                style="@style/Text.ItemMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                tools:text="오전 10:12" />

        </LinearLayout>

        <TextView
            android:id="@+id/notice_title"
            style="@style/Text.ItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/notice_time_group"
            android:textSize="14sp"
            tools:text="위치 공유" />

        <TextView
            android:id="@+id/notice_desc"
            style="@style/Text.ItemMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/notice_title"
            android:layout_alignParentStart="true"
            android:layout_marginTop="6dp"
            android:layout_toStartOf="@id/notice_time_group"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="SOS 요청 시 GPS 위치 전송" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
