<?xml version="1.0" encoding="utf-8"?>
<!-- 기록탭. 훈련 종류별 통계(이번 주 횟수, 점수, 항목별 달성률). 하나하나의 기록은 홈에서 본다 -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/record_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="100dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_margin"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/screen_h_margin">

        <TextView
            style="@style/Text.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginBottom="@dimen/space_l"
            android:text="@string/record_title" />

        <!-- 세그먼트 탭: 훈련 종류. 아래 내용은 고른 종류의 기록만 보여준다 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_segmented_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_simulation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_thumb"
                android:gravity="center"
                android:text="@string/record_report_simulation"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tab_call"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/record_report_call"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- ===== 요약·점수 변화·항목별 달성률 ===== -->
        <include
            android:id="@+id/report"
            layout="@layout/view_score_report" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
