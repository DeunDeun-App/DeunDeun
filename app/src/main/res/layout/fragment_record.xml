<?xml version="1.0" encoding="utf-8"?>
<!-- 기록탭 -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/record_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="100dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_margin"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/screen_h_margin">

        <TextView
            style="@style/Text.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginBottom="@dimen/space_l"
            android:text="@string/record_title" />

        <!-- 세그먼트 탭 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_segmented_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_history"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_thumb"
                android:gravity="center"
                android:text="@string/record_tab_history"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tab_score"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/record_tab_score"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- ===== 훈련 이력 ===== -->
        <LinearLayout
            android:id="@+id/mode_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Deundeun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/history_title"
                        style="@style/Text.ItemTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="재난 시뮬레이션" />

                    <TextView
                        android:id="@+id/history_meta"
                        style="@style/Text.ItemMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        tools:text="지진 대피 · 7월 17일 10:05" />

                    <!-- 범례 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_progress_fill" />

                        <TextView
                            style="@style/Text.ItemMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/record_legend_simulation" />

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="@dimen/space_m"
                            android:background="@drawable/bg_progress_fill"
                            android:backgroundTint="@color/orange_pale" />

                        <TextView
                            style="@style/Text.ItemMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/record_legend_call" />

                    </LinearLayout>

                    <com.example.deundeun.ui.record.GroupedBarChartView
                        android:id="@+id/bar_chart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="@dimen/space_m" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_m"
                android:text="@string/record_recent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recent_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@layout/item_training_record" />

        </LinearLayout>

        <!-- ===== 119 점수 변화 ===== -->
        <LinearLayout
            android:id="@+id/mode_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Deundeun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/score_title"
                        style="@style/Text.ItemTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="재난 시뮬레이션" />

                    <TextView
                        android:id="@+id/score_meta"
                        style="@style/Text.ItemMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        tools:text="지진 대피 · 7월 17일 10:05" />

                    <com.example.deundeun.ui.record.ScoreLineChartView
                        android:id="@+id/line_chart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="@dimen/space_xl" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Deundeun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_l"
                        android:text="@string/record_achievement_title" />

                    <!-- 달성률 항목은 개수가 가변이라 코드에서 채우도록 함 -->
                    <LinearLayout
                        android:id="@+id/achievement_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
