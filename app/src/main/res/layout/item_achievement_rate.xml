<?xml version="1.0" encoding="utf-8"?>
<!-- 주소 말하기 달성률 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_l"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_s">

        <TextView
            android:id="@+id/rate_label"
            style="@style/Text.ItemMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:textColor="@color/text_primary"
            tools:text="주소 말하기" />

        <TextView
            android:id="@+id/rate_percent"
            style="@style/Text.ItemMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="@color/orange_primary"
            tools:text="95%" />

    </RelativeLayout>

    <!-- 채움 너비는 백분율이라 ConstraintLayout 의 width_percent 로 잡는다 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@drawable/bg_progress_track">

        <View
            android:id="@+id/rate_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_progress_fill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.5"
            tools:layout_width="200dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
