<?xml version="1.0" encoding="utf-8"?>
<!-- 알림 한 건 -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card.Deundeun"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_m"
    android:foreground="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_subtle"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/ic_bell"
            tools:tint="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/notification_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="vertical">

            <View
                android:id="@+id/notification_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="end"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dot_badge" />

            <TextView
                android:id="@+id/notification_time"
                style="@style/Text.ItemMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="방금" />

        </LinearLayout>

        <TextView
            android:id="@+id/notification_title"
            style="@style/Text.ItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_toStartOf="@id/notification_meta"
            android:layout_toEndOf="@id/notification_icon"
            android:textSize="15sp"
            tools:text="재난문자 도착" />

        <TextView
            android:id="@+id/notification_desc"
            style="@style/Text.ItemMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/notification_title"
            android:layout_marginStart="14dp"
            android:layout_marginTop="5dp"
            android:layout_toStartOf="@id/notification_meta"
            android:layout_toEndOf="@id/notification_icon"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            tools:text="호우주의보 - 수원시" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
